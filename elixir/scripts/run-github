#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
symphony_executable="${SYMPHONY_EXECUTABLE:-${script_dir}/../bin/symphony}"

if [[ ! -x "${symphony_executable}" ]]; then
  echo "Symphony executable not found or not executable: ${symphony_executable}" >&2
  echo "Build Symphony before using this launcher." >&2
  exit 1
fi

app_profile=""
runtime_args=()

while (($# > 0)); do
  case "$1" in
    --app-profile)
      if (($# < 2)) || [[ -z "$2" ]]; then
        echo "--app-profile requires a profile name." >&2
        exit 1
      fi
      app_profile="$2"
      shift 2
      ;;
    *)
      runtime_args+=("$1")
      shift
      ;;
  esac
done

if [[ -n "${app_profile}" ]]; then
  profile_environment="$(${symphony_executable} github-app env --profile "${app_profile}")"

  while IFS='=' read -r name value; do
    case "${name}" in
      GITHUB_APP_ID|GITHUB_APP_INSTALLATION_ID|GITHUB_APP_PRIVATE_KEY_PATH)
        export "${name}=${value}"
        ;;
      *)
        echo "GitHub App profile returned an unexpected environment name." >&2
        exit 1
        ;;
    esac
  done <<< "${profile_environment}"

  if [[ -z "${GITHUB_APP_ID:-}" || -z "${GITHUB_APP_INSTALLATION_ID:-}" || -z "${GITHUB_APP_PRIVATE_KEY_PATH:-}" ]]; then
    echo "GitHub App profile is incomplete: ${app_profile}" >&2
    exit 1
  fi
else
  if ! command -v gh >/dev/null 2>&1; then
    echo "GitHub CLI is required for PAT fallback. Install it and run 'gh auth login', or use --app-profile." >&2
    exit 1
  fi

  github_token="$(gh auth token 2>/dev/null)"

  if [[ -z "${github_token}" ]]; then
    echo "GitHub CLI is not authenticated. Run 'gh auth login'." >&2
    exit 1
  fi

  export GITHUB_TOKEN="${github_token}"
fi

exec "${symphony_executable}" \
  --i-understand-that-this-will-be-running-without-the-usual-guardrails "${runtime_args[@]}"
